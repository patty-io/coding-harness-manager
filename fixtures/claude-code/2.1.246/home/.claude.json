{
  "mcpServers": {
    "semble": {
      "command": "uvx",
      "args": [
        "--from",
        "semble[mcp]",
        "semble"
      ],
      "type": "stdio"
    },
    "mem0-mcp": {
      "url": "https://mcp.mem0.ai/mcp",
      "type": "http"
    },
    "codegraph": {
      "type": "stdio",
      "command": "/Users/patrickrho/.nvm/versions/node/v24.7.0/bin/node",
      "args": [
        "/Users/patrickrho/.local/bin/codegraph",
        "serve",
        "--mcp"
      ]
    },
    "lightpanda": {
      "type": "http",
      "url": "http://127.0.0.1:9333/mcp"
    },
    "google-docs": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/Users/patrickrho/.local/mcp/google-docs-mcp/node_modules/@a-bonus/google-docs-mcp/dist/index.js"
      ],
      "env": {
        "SERVICE_ACCOUNT_PATH": "/Users/patrickrho/projects/spreadsheet-mcp/credentials/service-key.json",
        "GOOGLE_IMPERSONATE_USER": "patrick@patty.io",
        "MCP_TOOL_GROUPS": "docs,drive,sheets,utils"
      }
    },
    "google-sheets": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        "/Users/patrickrho/projects/spreadsheet-mcp",
        "run",
        "spreadsheet-mcp"
      ],
      "env": {
        "GOOGLE_SERVICE_ACCOUNT_FILE": "/Users/patrickrho/projects/spreadsheet-mcp/credentials/service-key.json"
      }
    }
  }
}