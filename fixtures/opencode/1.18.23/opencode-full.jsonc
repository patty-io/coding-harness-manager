{
  "$schema": "https://opencode.ai/config.json",
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "build"
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "snapshot": false,
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "/Users/patrickrho/.nvm/versions/node/v24.7.0/bin/node",
        "/Users/patrickrho/.local/bin/codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "lightpanda": {
      "type": "remote",
      "url": "http://127.0.0.1:9337/mcp",
      "enabled": true
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "REDACTED"
      }
    },
    "minimax": {
      "type": "local",
      "command": [
        "uvx",
        "minimax-coding-plan-mcp",
        "-y"
      ],
      "enabled": true,
      "environment": {
        "MINIMAX_API_KEY": "REDACTED",
        "MINIMAX_API_HOST": "https://api.minimax.io"
      }
    },
    "semble": {
      "command": [
        "uvx",
        "--from",
        "semble[mcp]",
        "semble"
      ],
      "type": "local",
      "enabled": true
    },
    "web-reader": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "REDACTED"
      }
    },
    "web-search-prime": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "REDACTED"
      }
    },
    "web-zread": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "REDACTED"
      }
    },
    "google-docs": {
      "type": "local",
      "command": [
        "node",
        "/Users/patrickrho/.local/mcp/google-docs-mcp/node_modules/@a-bonus/google-docs-mcp/dist/index.js"
      ],
      "enabled": true,
      "environment": {
        "SERVICE_ACCOUNT_PATH": "/Users/patrickrho/projects/spreadsheet-mcp/credentials/service-key.json",
        "GOOGLE_IMPERSONATE_USER": "patrick@patty.io",
        "MCP_TOOL_GROUPS": "docs,drive,sheets,utils"
      }
    }
  },
  "permission": "allow",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-goal-plugin"
  ],
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://jebo.ai/v1",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "cc/claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "limit": {
            "context": 1000000,
            "output": 32000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "cc/claude-opus-4-7": {
          "name": "Claude Opus 4.7",
          "limit": {
            "context": 1000000,
            "output": 32000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "cc/claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "limit": {
            "context": 1000000,
            "output": 32000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "cc/claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "limit": {
            "context": 200000,
            "output": 32000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "mistral/mistral-large-latest": {
          "name": "Mistral Large",
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "mm/MiniMax-M3": {
          "name": "MiniMax M3",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "gl/glm-5.2": {
          "name": "GLM 5.2 (Z.AI)",
          "limit": {
            "context": 1000000,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "max"
            }
          }
        },
        "km/kimi-for-coding": {
          "name": "Kimi for Coding",
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "cx/gpt-5.5": {
          "name": "GPT-5.5 (Codex)",
          "limit": {
            "context": 400000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
